rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isActiveUser() {
      return isSignedIn()
        && currentUserProfile().data.isActive == true;
    }

    function canManageUsers() {
      return isActiveUser()
        && (
          currentUserProfile().data.role == 'responsable'
          || currentUserProfile().data.role == 'adjoint'
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || canManageUsers()
        );

      allow create: if canManageUsers();
      allow update: if canManageUsers();
      allow delete: if false;
    }

    match /people/{personId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser();
      allow delete: if false;
    }

    match /requests/{requestId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser();
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser();
      allow delete: if false;
    }

    match /case_history/{historyId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if false;
      allow delete: if false;
    }
  }
}